OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
STORAGE_DIR=db
APP_DIR=app
DEBUGPY_HOST=0.0.0.0
DEBUGPY_PORT=5678
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.4
FILENAME_BOOST_EXACT=0.3
FILENAME_BOOST_NORMALIZED=0.25
CHUNK_NAME_BOOST_EXACT=0.5
CHUNK_NAME_BOOST_PARTIAL=0.3

# Optional: Langfuse tracing for ScopeAnalyzer (leave unset to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
